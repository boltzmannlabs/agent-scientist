      "source": "operator-confirmed 2026-09-12: UTF-8 or UTF-8-sig, exactly one data column",
      "files": {
        "input_path": {
          "formats": [
            "csv"
          ],
          "extra_columns": false,
          "csv_variants": [
            {
              "columns": [
                "sequences"
              ],
              "aliases": {
                "sequences": [
                  "sequence",
                  "seq"
                ]
              },
              "values": {
                "sequences": "protein"
              }
            },
            {
              "columns": [
                "smiles"
              ],
              "aliases": {
                "smiles": [
                  "smile"
                ]
              },
              "values": {
                "smiles": "smiles"
              }
            }
          ],
          "header_case_sensitive": false,
          "notes": "Exactly one UTF-8/UTF-8-sig data column: sequences (aliases sequence/seq) OR smiles (alias smile); no extra columns. Named pasted data can be built into this CSV."
        }
      }
    },
