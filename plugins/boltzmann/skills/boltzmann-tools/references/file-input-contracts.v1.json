{
  "schema": "boltzmann-file-input-contracts.v1",
  "policy": "Validate documented file rules and report specific unchecked aspects for explicit approval. Missing specialized rules do not make a file invalid. Never bypass known errors, authorization or archive security; never alter input bytes silently.",
  "tools": {
    "CircRNA": {
      "source": "modules/rna-circrna.md: protein FASTA; clarification-public-evidence.v1.json CircRNA: .fasta/.fa/.txt uploads",
      "files": {
        "fasta_file": {
          "formats": [
            "fasta",
            "fa",
            "txt"
          ],
          "content_format": "fasta",
          "alphabet": "protein",
          "header_case_sensitive": true,
          "notes": "Protein FASTA used to design circRNA candidates. Upload via `file_upload` first, then pass the returned platform path here"
        }
      }
    },
    "CircRNAEvaluate": {
      "source": "modules/rna-circrna.md: circRNA sequence FASTA; clarification-public-evidence.v1.json CircRNAEvaluate: .fasta/.fa/.txt uploads",
      "files": {
        "fasta_file": {
          "formats": [
            "fasta",
            "fa",
            "txt"
          ],
          "content_format": "fasta",
          "alphabet": "rna",
          "header_case_sensitive": true,
          "notes": "FASTA of circRNA sequence(s). Upload via `file_upload` first, then pass the returned platform path here"
        }
      }
    },
    "act_seek": {
      "source": "operator-confirmed 2026-09-12",
      "files": {
        "input_path": {
          "formats": [
            "pdb",
            "zip"
          ],
          "member_formats": [
            "pdb"
          ],
          "header_case_sensitive": true,
          "notes": "Uploaded file: `.pdb`, `.zip`"
        },
        "reference_path": {
          "formats": [
            "pdb"
          ],
          "residues_field": "active_sites",
          "header_case_sensitive": true,
          "notes": "Uploaded file: `.pdb`"
        }
      }
    },
    "Antibody_Backbone_to_Sequence_Generation": {
      "source": "operator-confirmed 2026-09-12: helper parses chain A regardless of H/L mode",
      "files": {
        "dataPath": {
          "formats": [
            "zip"
          ],
          "member_formats": [
            "pdb"
          ],
          "required_chains": [
            "A"
          ],
          "header_case_sensitive": true,
          "notes": "ZIP containing PDB backbone files; each must contain chain A, which the helper parses for both H/L modes."
        }
      }
    },
    "Cat_Pred": {
      "source": "operator-confirmed 2026-10-13; modules/protein-toolbox.md",
      "files": {
        "input_path": {
          "formats": [
            "csv"
          ],
          "extra_columns": true,
          "csv_variants": [
            {
              "columns": [
                "sequences",
                "smiles"
              ],
              "aliases": {},
              "values": {
                "sequences": "protein",
                "smiles": "smiles"
              }
            }
          ],
          "header_case_sensitive": false,
          "notes": "Required CSV storage path returned by `file_upload`. Headers are case-insensitive, but the singular aliases `sequence` and `smile` are rejected; `seq_id` is not required. Sequence and SMILES values retain their case. CatPred automatically predicts kcat, Km, and Ki for every row and has no user-selectable mode or `prediction_type` field."
        }
      }
    },
    "MegaDock": {
      "source": "operator-confirmed 2026-09-12",
      "files": {
        "ligand_path": {
          "formats": [
            "zip"
          ],
          "member_formats": [
            "pdb"
          ],
          "header_case_sensitive": true,
          "notes": "ZIP containing ligand PDB structures."
        },
        "receptor_path": {
          "formats": [
            "pdb"
          ],
          "header_case_sensitive": true,
          "notes": "One receptor PDB structure."
        }
      }
    },
    "Thermal_MPNN": {
      "source": "operator-confirmed 2026-09-12: empty chain selects first chain",
      "files": {
        "zip_path": {
          "formats": [
            "zip"
          ],
          "member_formats": [
            "pdb"
          ],
          "chains_field": "chain",
          "chain_scalar": true,
          "header_case_sensitive": true,
          "notes": "Remote ZIP containing PDB files, including nested directories (not nested ZIPs)."
        },
        "model_path": {
          "execution_blocked": true,
          "formats": [
            "pt"
          ],
          "header_case_sensitive": true,
          "notes": "Omit to use the platform default ${PRODUCT_BASE}/models/thermompnn/models/thermoMPNN_default.pt. Custom model PT inspection is not supported; do not fabricate or submit the placeholder path."
        }
      }
    },
