{
  "$id": "urn:rna-agents:registry-v1",
  "title": "RNA model/tool registry entry v1",
  "description": "Shared parent-owned registry entry. States form a strict adjacent-forward ladder: DISCOVERED -> EVIDENCE_REVIEWED -> WEIGHTS_AVAILABLE -> INSTALLED -> EXECUTION_TESTED -> BENCHMARK_VALIDATED -> PRODUCTION_APPROVED.",
  "type": "object",
  "required": [
    "id",
    "biological_domain",
    "supported_tasks",
    "repository",
    "state",
    "state_history",
    "last_verified",
    "known_limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "biological_domain": {
      "type": "string",
      "enum": ["mrna", "sirna", "aso", "grna", "circrna", "rna_structure", "rna_protein", "rna_ligand", "general_rna"]
    },
    "supported_tasks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "repository": { "type": "string" },
    "version": { "type": "string" },
    "commit": { "type": "string" },
    "weight_locations": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string" },
    "input_output_schemas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": { "type": "object" },
        "output": { "type": "object" }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "hardware_requirements": { "type": "string" },
    "benchmark_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    },
    "spec_path": { "type": "string" },
    "execution_report_path": { "type": "string" },
    "state": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "EVIDENCE_REVIEWED",
        "WEIGHTS_AVAILABLE",
        "INSTALLED",
        "EXECUTION_TESTED",
        "BENCHMARK_VALIDATED",
        "PRODUCTION_APPROVED"
      ]
    },
    "state_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state", "at", "by"],
        "additionalProperties": false,
        "properties": {
          "state": { "type": "string" },
          "at": { "type": "string" },
          "by": { "type": "string" },
          "evidence": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "last_verified": { "type": "string" },
    "known_limitations": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
