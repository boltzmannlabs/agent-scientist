{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smallmol:optimization:outcome:v1",
  "title": "Small-molecule optimization episode outcome",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "action_requested",
        "waiting",
        "completed",
        "stopped",
        "blocked"
      ]
    },
    "chosen_action": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "generate",
                "wait",
                "finalize",
                "blocked"
              ]
            },
            "parent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "library_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "action_key": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "parent_id",
            "library_id",
            "action_key"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "generate"
                  }
                }
              },
              "then": {
                "properties": {
                  "parent_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "library_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "action_key": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "final_candidate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "pending_jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_name": {
            "type": "string",
            "minLength": 1
          },
          "doc_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "job_name",
          "status"
        ],
        "anyOf": [
          {
            "required": [
              "doc_id"
            ],
            "properties": {
              "doc_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "receipt_id"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "stop_reason": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "information_requests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "assignment_id",
    "episode_id",
    "input_digest",
    "status",
    "chosen_action",
    "evidence_ids",
    "final_candidate_ids",
    "pending_jobs",
    "artifact_refs",
    "rationale",
    "stop_reason",
    "limitations",
    "information_requests"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "final_candidate_ids": {
            "minItems": 1
          },
          "pending_jobs": {
            "maxItems": 0
          },
          "information_requests": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "waiting"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "pending_jobs": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "artifact_refs": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "action_requested"
          }
        }
      },
      "then": {
        "properties": {
          "chosen_action": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "generate"
              },
              "parent_id": {
                "type": "string",
                "minLength": 1
              },
              "library_id": {
                "type": "string",
                "minLength": 1
              },
              "action_key": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "kind",
              "parent_id",
              "library_id",
              "action_key"
            ]
          },
          "pending_jobs": {
            "maxItems": 0
          },
          "final_candidate_ids": {
            "maxItems": 0
          },
          "information_requests": {
            "maxItems": 0
          },
          "artifact_refs": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "description": "JSON shape alone is not scientific or execution proof. The host checks assignment digests, registered identities, actual receipts, eligibility and joint task success. action_requested is an unexecuted request only for an explicitly authorized host_mediated assignment; it is never a job receipt or scientific completion."
}
